{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "plugin",
      "displayName": "Plugin completo",
      "description": "Compila todo, incluido el plugin (descarga JUCE la primera vez)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "plugin-debug",
      "displayName": "Plugin completo (depuración)",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "core",
      "displayName": "Solo dsp + core",
      "description": "Rápido y sin JUCE: para trabajar en los algoritmos y sus tests",
      "binaryDir": "${sourceDir}/build-core",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ESCEQ_BUILD_PLUGIN": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "plugin", "configurePreset": "plugin", "configuration": "Release" },
    { "name": "plugin-debug", "configurePreset": "plugin-debug", "configuration": "Debug" },
    { "name": "core", "configurePreset": "core", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "plugin", "configurePreset": "plugin", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "plugin-debug", "configurePreset": "plugin-debug", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "core", "configurePreset": "core", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
